{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Listen for Xdebug",
            "type": "php",
            "request": "launch",
            "port": 9003,
            "pathMappings": {
                "/home/u82085/www/task5": "${workspaceRoot}"
            }
        },
        {
            "name": "Launch built-in server",
            "type": "php",
            "request": "launch",
            "runtimeArgs": [
                "-S", "127.0.0.1:8000",
                "-t", "."
            ],
            "port": 8000,
            "serverReadyAction": {
                "action": "openExternally" // ВАЖНО: открывать в браузере, а не внутри VS Code
            }
        }
    ]
}